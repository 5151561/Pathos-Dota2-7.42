<Project Sdk="Microsoft.NET.Sdk">
  <!--
    DOTA2 英雄 VFX 贴图生成器（开发期工具，不参与扩展 DLL 编译/部署）。
    用法（在仓库根目录）：dotnet run 加 project 参数 tools/VfxGen，参数传仓库根目录（见 Program.cs 顶部注释）
    会覆盖 Resources/Heroes/<hero>/ 下由本工具负责的特效 PNG（见 Program.cs 中的清单）。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
