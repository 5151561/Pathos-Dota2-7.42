<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 必须以 Expansion 结尾，Pathos 引擎才会从 Expansions 目录自动加载 -->
    <AssemblyName>DotaHeroesExpansion</AssemblyName>
    <RootNamespace>Pathos</RootNamespace>
    <!-- 跨平台 net10.0：同时支持 Windows / macOS / Linux 构建与运行 -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>Latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- 优先加载本地覆写配置 LocalPathos.props（已加入 .gitignore，不会提交到 Git） -->
  <Import Project="LocalPathos.props" Condition="Exists('LocalPathos.props')" />

  <!-- Pathos 安装路径：优先 LocalPathos.props，其次环境变量 PATHOS_INSTALL_DIR，默认官方路径 -->
  <PropertyGroup>
    <PathosInstallation Condition="'$(PathosInstallation)' == '' and '$(PATHOS_INSTALL_DIR)' != ''">$(PATHOS_INSTALL_DIR)</PathosInstallation>
    <PathosInstallation Condition="'$(PathosInstallation)' == ''">C:\Games\Pathos</PathosInstallation>
    <!-- 调试时默认进入的模块（NetHack Codex 官方主线） -->
    <PathosModule>NetHack</PathosModule>
    <!-- 调试时可选自动开局的英雄名（留空则进入选人界面） -->
    <PathosHero></PathosHero>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.3" PrivateAssets="all" GeneratePathProperty="true" />
    <!-- 将 0Harmony.dll 内嵌为资源，使最终仍保持单 DLL 部署（兼容 Windows/macOS/Linux 与 PathosMaker） -->
    <EmbeddedResource Include="$(PkgLib_Harmony)/lib/net10.0/0Harmony.dll" LogicalName="0Harmony.dll" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="InvLibrary">
      <HintPath>$(PathosInstallation)\Inv.Library.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PathosLibrary">
      <HintPath>$(PathosInstallation)\PathosLibrary.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PathosEngine">
      <HintPath>$(PathosInstallation)\PathosEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PathosOfficial">
      <HintPath>$(PathosInstallation)\PathosOfficial.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 将按英雄分目录存放的贴图（Resources/**/<tileset>/*.png）自动聚合到 PathosMaker 要求的 Atlases/<tileset>/ 暂存目录 -->
  <Target Name="StageAtlasesForPathosMaker" BeforeTargets="PathosMakerPostBuild">
    <PropertyGroup>
      <_AtlasStagingDir>$(ProjectDir)Atlases</_AtlasStagingDir>
    </PropertyGroup>

    <ItemGroup>
      <_AbsurdPngs Include="$(ProjectDir)Resources\**\absurd\*.png" />
      <_ClassicPngs Include="$(ProjectDir)Resources\**\classic\*.png" />
      <_GeoduckPngs Include="$(ProjectDir)Resources\**\geoduck\*.png" />
      <_SonyvandaPngs Include="$(ProjectDir)Resources\**\sonyvanda\*.png" />

      <_AbsurdDistinct Include="@(_AbsurdPngs->'%(Filename)%(Extension)')" />
      <_ClassicDistinct Include="@(_ClassicPngs->'%(Filename)%(Extension)')" />
      <_GeoduckDistinct Include="@(_GeoduckPngs->'%(Filename)%(Extension)')" />
      <_SonyvandaDistinct Include="@(_SonyvandaPngs->'%(Filename)%(Extension)')" />
    </ItemGroup>

    <!-- 校验不同英雄之间是否存在同名贴图冲突 -->
    <RemoveDuplicates Inputs="@(_AbsurdDistinct)">
      <Output TaskParameter="Filtered" ItemName="_AbsurdUnique" />
    </RemoveDuplicates>
    <Error Condition="@(_AbsurdPngs->Count()) != @(_AbsurdUnique->Count())"
           Text="Detected duplicate PNG filename(s) across Resources/**/absurd/. Glyph filenames must be globally unique." />

    <RemoveDuplicates Inputs="@(_ClassicDistinct)">
      <Output TaskParameter="Filtered" ItemName="_ClassicUnique" />
    </RemoveDuplicates>
    <Error Condition="@(_ClassicPngs->Count()) != @(_ClassicUnique->Count())"
           Text="Detected duplicate PNG filename(s) across Resources/**/classic/. Glyph filenames must be globally unique." />

    <RemoveDuplicates Inputs="@(_GeoduckDistinct)">
      <Output TaskParameter="Filtered" ItemName="_GeoduckUnique" />
    </RemoveDuplicates>
    <Error Condition="@(_GeoduckPngs->Count()) != @(_GeoduckUnique->Count())"
           Text="Detected duplicate PNG filename(s) across Resources/**/geoduck/. Glyph filenames must be globally unique." />

    <RemoveDuplicates Inputs="@(_SonyvandaDistinct)">
      <Output TaskParameter="Filtered" ItemName="_SonyvandaUnique" />
    </RemoveDuplicates>
    <Error Condition="@(_SonyvandaPngs->Count()) != @(_SonyvandaUnique->Count())"
           Text="Detected duplicate PNG filename(s) across Resources/**/sonyvanda/. Glyph filenames must be globally unique." />

    <RemoveDir Directories="$(_AtlasStagingDir)" Condition="Exists('$(_AtlasStagingDir)')" />
    <MakeDir Directories="$(_AtlasStagingDir)\absurd;$(_AtlasStagingDir)\classic;$(_AtlasStagingDir)\geoduck;$(_AtlasStagingDir)\sonyvanda" />

    <Copy SourceFiles="@(_AbsurdPngs)" DestinationFiles="@(_AbsurdPngs->'$(_AtlasStagingDir)\absurd\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(_ClassicPngs)" DestinationFiles="@(_ClassicPngs->'$(_AtlasStagingDir)\classic\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(_GeoduckPngs)" DestinationFiles="@(_GeoduckPngs->'$(_AtlasStagingDir)\geoduck\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(_SonyvandaPngs)" DestinationFiles="@(_SonyvandaPngs->'$(_AtlasStagingDir)\sonyvanda\%(Filename)%(Extension)')" />
  </Target>

  <!-- 编译后自动运行 PathosMaker 打包图集/翻译并部署到 Expansions 目录 -->
  <Target Name="PathosMakerPostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="&quot;$(PathosInstallation)\PathosMaker.exe&quot; &quot;$(PathosInstallation)&quot; &quot;$(ProjectDir.TrimEnd('\'))&quot; &quot;$(TargetDir)$(TargetName).dll&quot;" />
  </Target>
</Project>
