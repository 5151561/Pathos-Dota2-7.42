<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 必须以 Expansion 结尾，Pathos 引擎才会从 Expansions 目录自动加载 -->
    <AssemblyName>DotaHeroesExpansion</AssemblyName>
    <RootNamespace>Pathos</RootNamespace>
    <!-- 跨平台 net10.0：同时支持 Windows / macOS / Linux 构建与运行 -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>Latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- 优先加载本地覆写配置 LocalPathos.props（已加入 .gitignore，不会提交到 Git） -->
  <Import Project="LocalPathos.props" Condition="Exists('LocalPathos.props')" />

  <!-- Pathos 安装路径：优先 LocalPathos.props，其次环境变量 PATHOS_INSTALL_DIR，默认官方路径 -->
  <PropertyGroup>
    <PathosInstallation Condition="'$(PathosInstallation)' == '' and '$(PATHOS_INSTALL_DIR)' != ''">$(PATHOS_INSTALL_DIR)</PathosInstallation>
    <PathosInstallation Condition="'$(PathosInstallation)' == ''">C:\Games\Pathos</PathosInstallation>
    <!-- 调试时默认进入的模块（NetHack Codex 官方主线） -->
    <PathosModule>NetHack</PathosModule>
    <!-- 调试时可选自动开局的英雄名（留空则进入选人界面） -->
    <PathosHero></PathosHero>
  </PropertyGroup>

  <!-- tools/ 下是独立的开发期工具工程（如 VFX 贴图生成器），不参与扩展 DLL 编译 -->
  <ItemGroup>
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.3" PrivateAssets="all" GeneratePathProperty="true" />
    <!-- 将 0Harmony.dll 内嵌为资源，使最终仍保持单 DLL 部署（兼容 Windows/macOS/Linux 与 PathosMaker） -->
    <EmbeddedResource Include="$(PkgLib_Harmony)/lib/net10.0/0Harmony.dll" LogicalName="0Harmony.dll" />
    <!-- 将全部 UI 多语言词表内嵌进扩展 DLL，禁止 MSBuild 按语言后缀拆分卫星程序集，保持单 DLL 部署 -->
    <EmbeddedResource Include="Resources\Localization\ui.*.json" LogicalName="Localization.%(Filename)%(Extension)" WithCulture="false" Culture="" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="InvLibrary">
      <HintPath>$(PathosInstallation)\Inv.Library.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="InvPlatform">
      <HintPath>$(PathosInstallation)\Inv.Platform.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PathosLibrary">
      <HintPath>$(PathosInstallation)\PathosLibrary.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PathosEngine">
      <HintPath>$(PathosInstallation)\PathosEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PathosOfficial">
      <HintPath>$(PathosInstallation)\PathosOfficial.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 将按英雄分目录存放的单份贴图（Resources/**/*.png）自动分发到 PathosMaker 要求的四套 Atlases/<tileset>/ 暂存目录 -->
  <Target Name="StageAtlasesForPathosMaker" BeforeTargets="PathosMakerPostBuild">
    <PropertyGroup>
      <_AtlasStagingDir>$(ProjectDir)Atlases</_AtlasStagingDir>
    </PropertyGroup>

    <ItemGroup>
      <_SourcePngs Include="$(ProjectDir)Resources\**\*.png" />
      <_SourceDistinct Include="@(_SourcePngs->'%(Filename)%(Extension)')" />
    </ItemGroup>

    <!-- 校验不同目录之间是否存在同名贴图冲突 -->
    <RemoveDuplicates Inputs="@(_SourceDistinct)">
      <Output TaskParameter="Filtered" ItemName="_SourceUnique" />
    </RemoveDuplicates>
    <Error Condition="@(_SourcePngs->Count()) != @(_SourceUnique->Count())"
           Text="Detected duplicate PNG filename(s) across Resources/. Glyph filenames must be globally unique." />

    <RemoveDir Directories="$(_AtlasStagingDir)" Condition="Exists('$(_AtlasStagingDir)')" />
    <MakeDir Directories="$(_AtlasStagingDir)\absurd;$(_AtlasStagingDir)\classic;$(_AtlasStagingDir)\geoduck;$(_AtlasStagingDir)\sonyvanda" />

    <Copy SourceFiles="@(_SourcePngs)" DestinationFiles="@(_SourcePngs->'$(_AtlasStagingDir)\absurd\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(_SourcePngs)" DestinationFiles="@(_SourcePngs->'$(_AtlasStagingDir)\classic\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(_SourcePngs)" DestinationFiles="@(_SourcePngs->'$(_AtlasStagingDir)\geoduck\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(_SourcePngs)" DestinationFiles="@(_SourcePngs->'$(_AtlasStagingDir)\sonyvanda\%(Filename)%(Extension)')" />
  </Target>

  <!-- 编译后自动运行 PathosMaker 打包图集/翻译并部署到 Expansions 目录 -->
  <Target Name="PathosMakerPostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="&quot;$(PathosInstallation)\PathosMaker.exe&quot; &quot;$(PathosInstallation)&quot; &quot;$(ProjectDir.TrimEnd('\'))&quot; &quot;$(TargetDir)$(TargetName).dll&quot;" />
  </Target>
</Project>
